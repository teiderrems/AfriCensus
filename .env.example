POSTGRES_DB=africensus
POSTGRES_USER=africensus
POSTGRES_PASSWORD=africensus
DATABASE_URL=postgresql+psycopg://africensus:africensus@127.0.0.1:5432/africensus
CORS_ORIGINS=http://localhost:4200,http://127.0.0.1:4200,http://localhost:8000,http://127.0.0.1:8000
FRONTEND_DIST=frontend/dist/africensus-link/browser
DEFAULT_LANGUAGE=fr
SUPPORTED_LANGUAGES=fr,en
ALLOWED_HOSTS=*
SECURITY_HEADERS_ENABLED=true
AUTH_RATE_LIMIT_ATTEMPTS=5
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
AFRICENSUS_PASSWORD_ITERATIONS=210000
AFRICENSUS_SECRET_KEY=change-me
AFRICENSUS_ACCESS_TOKEN_TTL=3600
AFRICENSUS_REFRESH_TOKEN_TTL=604800

# Storage Configuration (local, s3, google_drive)
MEDIA_STORAGE_PROVIDER=local
MEDIA_BASE_URL=

# Google Drive Storage Config
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# AWS S3 Storage Config
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=
AWS_BUCKET_NAME=
